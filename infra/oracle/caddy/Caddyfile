# PocketBase's admin pages and superuser login are never served to the internet, by name or by id
# (pbc_3142635823 is _superusers). Reach them over SSH instead: README, "Admin".
(admin_locked) {
	@admin path /_ /_/* /api/collections/_* /api/collections/pbc_3142635823/*
	respond @admin 404
}

{$API_HOST} {
	encode gzip
	request_body {
		max_size 2GB
	}
	reverse_proxy api:8080 {
		transport http {
			read_timeout 10m
		}
	}
}

{$PB_HOST} {
	encode gzip
	import admin_locked
	reverse_proxy pocketbase:8090
}

# The dev stack (docker-compose.dev.yml). Until it runs, these answer 502.
{$API_DEV_HOST} {
	encode gzip
	request_body {
		max_size 2GB
	}
	reverse_proxy dev-api:8080 {
		transport http {
			read_timeout 10m
		}
	}
}

{$PB_DEV_HOST} {
	encode gzip
	import admin_locked
	reverse_proxy dev-pocketbase:8090
}
